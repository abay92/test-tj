# syntax=docker/dockerfile:1

# Image khusus untuk mock publisher (dijalankan lewat profile "mock")
FROM golang:1.27-alpine AS builder

WORKDIR /src
ARG TARGETARCH

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux GOARCH="${TARGETARCH:-$(go env GOARCH)}" \
    go build -trimpath -ldflags="-s -w" -o /out/mock-publisher ./cmd/mock-publisher

FROM alpine:3.22

RUN apk add --no-cache ca-certificates tzdata \
    && addgroup -S app \
    && adduser -S -G app -h /app app

ENV TZ=Asia/Jakarta \
    MQTT_BROKER=tcp://mosquitto:1883 \
    MQTT_TOPIC_TEMPLATE=/fleet/vehicle/{vehicle_id}/location \
    VEHICLE_IDS=B1234XYZ \
    PUBLISH_INTERVAL=2s

WORKDIR /app
COPY --from=builder /out/mock-publisher /app/mock-publisher

USER app
ENTRYPOINT ["/app/mock-publisher"]
