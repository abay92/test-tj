# connection db
# Untuk docker compose, DB_HOST/TCP_BROKER/RABBITMQ_URL otomatis
# diarahkan ke nama service (postgres, mosquitto, rabbitmq).
DB_HOST=localhost
DB_PORT=5432
DB_USER=test
DB_PASSWORD=test
DB_NAME=test

TCP_BROKER=tcp://localhost:1883
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
APP_PORT=8080

# Geofence default: Monas Jakarta, radius 50 meter
GEOFENCE_LAT=-6.1753924
GEOFENCE_LNG=106.8271528
GEOFENCE_RADIUS=50

# Mock publisher (profil "mock")
MQTT_TOPIC_TEMPLATE=/fleet/vehicle/{vehicle_id}/location
MOCK_VEHICLE_IDS=B1234XYZ,B5678ABC
MOCK_INTERVAL=2s

# --- Hanya dipakai docker-compose untuk port yang di-publish ke host ---
DB_PORT_HOST=5433
MQTT_PORT=1883
RABBITMQ_PORT=5672
# 15673 dipakai karena 15672 sudah dipakai RabbitMQ native (brew services)
RABBITMQ_UI_PORT=15673
